# Virtual environment
venv/
__pycache__/
*.pyc

# Local tool config, not part of the project
.claude/

# Downloaded models (large binaries, re-downloaded automatically on first run)
pet/local_models/
pet/recognition/face_models/

# Personal/sensitive data: face photos, trained face-recognition models,
# conversation history and identity database — never published.
pet/recognition/samples/
pet/recognition/models/
pet/data/

# Generated sprites (sliced from pet/assets/sheets/ or procedural placeholders, regenerated on first run)
pet/assets/sprites/
pet/assets/sounds/

# Temporary test artifacts
_test_*.py
*.wav

# Installer build output (PyInstaller + Inno Setup), regenerated by
# installer/build.ps1 — not source, never published.
build/
dist/
installer/dist_installer/
